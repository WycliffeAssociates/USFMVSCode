{
    "name": "usfmvscode",
    "displayName": "USFMVSCode",
    "description": "USFM Support for VS Code",
    "version": "0.5.0",
    "publisher": "wycliffeassociates",
    "repository": "https://github.com/WycliffeAssociates/USFMVSCode",
    "engines": {
        "vscode": "^1.71.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onLanguage:usfm",
        "onCommand:usfmvscode.goToReference"
    ],
    "main": "./dist/extension",
    "contributes": {
        "languages": [
            {
                "id": "usfm",
                "extensions": [
                    ".usfm"
                ],
                "aliases": [
                    "USFM"
                ]
            }
        ],
        "grammars": [
            {
                "language": "usfm",
                "scopeName": "source.usfm",
                "path": "./syntaxes/usfm.tmGrammer.json"
            }
        ],
        "commands": [
            {
                "command": "usfmvscode.goToReference",
                "title": "USFM: Go to Reference"
            }
        ],
        "keybindings": [
            {
                "command": "usfmvscode.goToReference",
                "key": "ctrl+alt+g",
                "mac": "cmd+alt+g",
                "when": "editorLangId == usfm"
            }
        ],
        "configurationDefaults": {
            "[usfm]": {
                "editor.wordWrapBreakBeforeCharacters": "([{‘“〈《「『【〔（［｛｢£¥＄￡￥"
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "webpack",
        "watch": "webpack --watch",
        "package": "webpack --mode production --devtool hidden-source-map",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "lint": "eslint src --ext ts --max-warnings 0",
        "test": "npm run lint && npm run compile-tests && npm run compile && npm run test:unit",
        "test:unit": "mocha --ui tdd \"out/test/unit/**/*.test.js\"",
        "test:integration": "npm run compile-tests && npm run compile && npm run test:integration:run",
        "test:integration:run": "node ./out/test/runTest.js"
    },
    "dependencies": {
        "vscode-languageclient": "^8.0.2",
        "vscode-languageserver": "^8.0.2",
        "vscode-languageserver-textdocument": "^1.0.7"
    },
    "devDependencies": {
        "@stylistic/eslint-plugin": "^3.1.0",
        "@types/glob": "^8.0.0",
        "@types/mocha": "^9.1.1",
        "@types/node": "^16.18.126",
        "@types/vscode": "^1.71.0",
        "@typescript-eslint/eslint-plugin": "^6.21.0",
        "@typescript-eslint/parser": "^6.21.0",
        "@vscode/test-electron": "^2.5.2",
        "eslint": "^8.57.1",
        "glob": "^8.0.3",
        "mocha": "^12.0.3",
        "ts-loader": "^9.3.1",
        "typescript": "^4.8.2",
        "webpack": "^5.105.0",
        "webpack-cli": "^4.10.0"
    }
}
